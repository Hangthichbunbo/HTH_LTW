
@model IEnumerable<hth_241230719_De1.Models.TaiSan>
<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
    <a href="#">Xem tất cả &rsaquo;</a>
</div>
<div class="grid">
    @foreach (var item in Model)
    {
        <div class="asset-card">
            <a href="#">
                <img src="~/images/@item.Anh" alt="@item.TenTs"/>
            </a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@item.NguyenGia tr</span>
                <button class="btn-buy">Chi tiet</button>
            </div>
        </div>
    }
</div>
