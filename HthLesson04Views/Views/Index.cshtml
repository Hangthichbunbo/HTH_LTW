@{
    ViewData["Title"] = "Razor C#";
}
<h1>Ngôn ngữ lập trình Razor Code</h1>
<hr/>
@{
    var name = "Hoàng Thu Hằng";
    int age = 20;
    string email = "hoanghang210926@gmail.com";
}
<div class="alert alert-danger">
    <p>Welcom to @name</p>
    <p>Age: @age</p>
    <p>Email: @email</p>
</div>
<div class="alert alert-success">
    <h2>Welcom @name</h2>
    @{
        var currentDate = DateTime.Now.DayOfWeek;
        var greetingMessage = currentDate == DayOfWeek.Saturday || currentDate == DayOfWeek.Sunday ? "Chúc bạn một ngày cuối tuần vui vẻ!" : "Chúc bạn một ngày làm việc hiệu quả!";
    }
    <h3>@greetingMessage</h3>
</div>

<div class="alert alert-light">
    <h2>Cấu trúc If</h2>
    @if (age >= 18)
    {
        <p>Bạn đã đủ tuổi để tham gia các hoạt động này.</p>
    }
    else
    {
        <p>Bạn chưa đủ tuổi để tham gia các hoạt động này.</p>
    }
</div>
<div class="alert alert-info">
    <h2>Cấu trúc for</h2>
    <ul>
        @for (int i = 1; i <= 10; i++)
        {
            if(i %2 == 0)
            {
                <button class="btn btn-danger">@i</button>
            }
            else
            {
                <button class="btn btn-success">@i</button>
            }
        }
    </ul>
</div>
@{
    string[] imgs = { "01.jpg", "02.jpg", "03.jpg", "04.jpg" };
}
<div>
    @foreach (var item in imgs)
    {
        <img src="/icons/@item" alt="@item" width="200px"/>   
    }
</div>