@model IEnumerable<Hthlesson06Models.Models.HthMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HthMemberUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HthMemberPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HthMemberEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HthMemberFullName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HthMemberUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.HthMemberPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.HthMemberEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.HthMemberFullName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.HthMemberId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.HthMemberId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.HthMemberId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
